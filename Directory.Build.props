<Project>
  <!-- Společná nastavení pro všechny projekty v řešení (viz CLAUDE.md: nullable zapnuté, C# 12). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Release: symboly zabalené v binárce — čistá distribuce, ale stack trace s čísly řádků. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
