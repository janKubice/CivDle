<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testy UI vrstvy (rozvržení, formátování popisků). Na rozdíl od jádra sem
    MonoGame patří — UI ho používá. Testuje se jen čistý výpočet, žádné okno
    ani grafické zařízení se nevytváří, takže testy běží headless.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Cílová platforma musí kopírovat CivDle (viz jeho csproj: na Windows jede hra
    na DirectX, a to je net8.0-windows). Kdyby se rozešly, projektová reference
    přestane jít přeložit.
  -->
  <PropertyGroup>
    <UseDirectX Condition="'$(UseDirectX)' == '' and $(RuntimeIdentifier.StartsWith('win'))">true</UseDirectX>
    <UseDirectX Condition="'$(UseDirectX)' == '' and '$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">true</UseDirectX>
    <UseDirectX Condition="'$(UseDirectX)' == ''">false</UseDirectX>
    <TargetFramework Condition="'$(UseDirectX)' == 'true'">net8.0-windows</TargetFramework>
    <EnableWindowsTargeting Condition="'$(UseDirectX)' == 'true'">true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CivDle\CivDle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\**" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
